NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

CVUP_ADMIN_EMAIL=admin@example.com
CVUP_ADMIN_PASSWORD=replace_with_a_strong_private_password
CVUP_ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Recommended in production. If omitted, the admin session secret is used as a fallback.
CVUP_REQUEST_TOKEN_SECRET=replace_with_a_separate_random_secret_of_at_least_32_characters

# Optional real merchant checkout URL. If omitted, the site falls back to WhatsApp payment contact.
NEXT_PUBLIC_SOFIZPAY_PAYMENT_URL=
